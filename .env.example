# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.

# Google Maps JavaScript API key (restrict it to your domains — see README)
VITE_GOOGLE_MAPS_API_KEY=

# Your default affiliate / partner ID. Used when a venue has no affiliate.refId of its own.
VITE_AFFILIATE_REF=findfunaround

# Optional: endpoint that receives click events via navigator.sendBeacon (JSON body)
VITE_TRACK_ENDPOINT=
